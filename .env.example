# Copy to .env and fill in values before running outside Docker
# (docker-compose passes these directly via the `environment:` block)

# Node environment
NODE_ENV=production

# Port the Express server binds to
PORT=3000

# Sub-path prefix when hosting behind a reverse proxy at a non-root path.
# Example: BASE_PATH=/remotarr  ->  app lives at https://host/remotarr/
# Leave blank to serve from root.
BASE_PATH=

# SQLite database path inside the container (maps to the /data volume).
# The JWT signing secret and your PIN hash live in this database — nothing
# else needs to be configured manually.
DB_PATH=/data/remotarr.db
